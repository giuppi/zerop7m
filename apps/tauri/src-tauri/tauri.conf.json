{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZeroP7M",
  "version": "1.0.2",
  "identifier": "io.github.giuppi.zerop7m",
  "build": {
    "beforeDevCommand": "pnpm --filter web dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --filter web build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "ZeroP7M — OpenCAdES Reader",
        "width": 1200,
        "height": 800,
        "minWidth": 640,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data: p7m:; connect-src 'none'; object-src 'none'; frame-src 'self' blob:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["p7m"],
        "name": "Documento Firmato P7M",
        "description": "Documento con firma digitale PKCS#7 / CAdES",
        "mimeType": "application/pkcs7-mime",
        "role": "Viewer"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "iOS": {
      "developmentTeam": ""
    }
  }
}
